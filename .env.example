# Discord Developer Portal > Applications > (uygulaman) > Bot
DISCORD_TOKEN=bot_tokenin_buraya

# Panel giriş kullanıcı adı ve şifresi (sadece bunu bilenler girebilir)
ADMIN_USER=kullanici_adin
ADMIN_PASS=guclu_bir_sifre

# Oturum şifreleme anahtarı (opsiyonel, rastgele uzun bir yazı)
SESSION_SECRET=rastgele-uzun-bir-anahtar-yaz

# Panel adresin (opsiyonel, Discord'daki !panel komutu için)
PUBLIC_URL=https://offical.zanity.net

# Panel portu (Render otomatik verir)
PORT=10000

# Paneli Discord'a bağlamadan denemek için 1 yap
DEMO_MODE=0

# Kalıcı veri klasörü (Render Disk eklersen /data gibi)
DATA_DIR=./data
