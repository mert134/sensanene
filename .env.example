# Discord Developer Portal > Applications > (uygulaman) > Bot
DISCORD_TOKEN=bot_tokenin_buraya
CLIENT_ID=uygulama_client_id
CLIENT_SECRET=oauth2_client_secret

# Render'daki servis adresin (sonunda / olmadan)
PUBLIC_URL=https://discord-bot-panel.onrender.com

# Oturum şifreleme anahtarı (rastgele uzun bir yazı)
SESSION_SECRET=rastgele-uzun-bir-anahtar-yaz

# Panel portu (Render otomatik verir)
PORT=10000

# Paneli Discord'a bağlamadan denemek için 1 yap
DEMO_MODE=0

# Kalıcı veri klasörü (Render Disk eklersen /data gibi)
DATA_DIR=./data

# (Opsiyonel) Sadece bu Discord kullanıcı ID'si (veya virgülle ayırarak birden fazla) panele girebilsin.
# Boş bırakılırsa Discord uygulamasının sahibi otomatik olarak tek kurucu kabul edilir.
OWNER_ID=

